PORT=5177

# Anthropic (Claude): create a key at console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# NVIDIA API Catalog / NIM: create a key at build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# OpenRouter: create a key at openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Comma-separated models OpenRouter tries if the main one is busy or down.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free

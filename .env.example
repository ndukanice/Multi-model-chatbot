PORT=5177

# NVIDIA: create a key at build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Anthropic: create a key at console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenRouter: create a key at openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Comma-separated models OpenRouter tries if the main one is busy or down.
OPENROUTER_FALLBACK_MODELS=poolside/laguna-s-2.1:free

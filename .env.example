PORT=5177

# Mistral free tier: create a key in Mistral Studio.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# NVIDIA API Catalog / NIM: create a key at build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Hugging Face Inference Providers: create a token at huggingface.co/settings/tokens
# (needs the "Make calls to Inference Providers" permission).
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
